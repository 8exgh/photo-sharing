# Admin password for the app
ADMIN_PASSWORD=

# Docker image to deploy
IMAGE=ghcr.io/8exgh/tik_tycholaz:latest

# GHCR credentials (needed to pull private images)
GHCR_USER=8exgh
GHCR_TOKEN=
