Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "ovh-sim"

  config.vm.network "private_network", ip: "192.168.56.20"

  config.vm.network "forwarded_port", guest: 80, host: 8090, auto_correct: true
  config.vm.network "forwarded_port", guest: 443, host: 8453, auto_correct: true

  config.vm.provider :libvirt do |lv|
    lv.cpus = 2
    lv.memory = 4096
  end

  # Pre-configure insecure registry so Docker trusts the local dev registry
  # once the bootstrap script installs it
  config.vm.provision "shell", inline: <<-SHELL
    mkdir -p /etc/docker
    echo '{"insecure-registries": ["192.168.56.1:5000"]}' > /etc/docker/daemon.json
  SHELL
end
